SINGBOX_VERSION=1.14.2
GO_VERSION=1.26.8
ANDROID_API=21
JAVAPKG=com.ironpanel
LIBNAME=box
# Legacy-mobile tag set from sing-box's own cmd/internal/build_libbox
# (minus naive outbound): full modern protocols incl. Reality/uTLS,
# WireGuard, OpenVPN-client, OpenConnect-client (ocserv).
SINGBOX_TAGS=with_gvisor,with_quic,with_wireguard,with_utls,with_clash_api,with_usbip,with_openvpn,with_openconnect,badlinkname,tfogo_checklinkname0,with_low_memory
# gomobile comes from SagerNet's fork, pinned by sing-box's own go.mod
# (github.com/sagernet/gomobile) — upstream gomobile cannot link this tree.
GOMOBILE_PKG=github.com/sagernet/gomobile/cmd/gomobile
